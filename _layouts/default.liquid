<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {%- if page.url == '/' -%}
        {{ site.title }}
      {%- else -%}
        {{ page.title }} · {{ site.title }}
      {%- endif -%}
    </title>
    <meta name="description" content="{{ page.description | default: site.description | strip }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@1,6..72,400&display=swap">
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | relative_url }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css">
  </head>
  <body>
    <main>
      {%- assign section = '' -%}
      {%- if page.url contains '/projects/' -%}
        {%- assign section = 'projects' -%}
      {%- elsif page.url contains '/library/' -%}
        {%- assign section = 'library' -%}
      {%- elsif page.url contains '/blog/' -%}
        {%- assign section = 'blog' -%}
      {%- elsif page.url contains '/publications/' -%}
        {%- assign section = 'publications' -%}
      {%- elsif page.url contains '/resume/' -%}
        {%- assign section = 'resume' -%}
      {%- endif -%}
      <header class="masthead">
        <div>
          <a class="name" href="{{ '/' | relative_url }}">Lam Nguyen</a>
          {%- if section != '' -%}
            <a class="page-name" href="{{ '/' | append: section | append: '/' | relative_url }}">{{ section | capitalize }}</a>
          {%- endif -%}
        </div>
        <nav class="sitenav" aria-label="Site">
          <a
            href="{{ '/projects/' | relative_url }}"
            {% if section == 'projects' or section == 'library' %}
              aria-current="page"
            {% endif %}
            >projects</a
          >
          <a
            href="{{ '/blog/' | relative_url }}"
            {% if section == 'blog' %}
              aria-current="page"
            {% endif %}
            >blog</a
          >
          <a
            href="{{ '/publications/' | relative_url }}"
            {% if section == 'publications' %}
              aria-current="page"
            {% endif %}
            >publications</a
          >
          <a
            href="{{ '/resume/' | relative_url }}"
            {% if section == 'resume' %}
              aria-current="page"
            {% endif %}
            >resume</a
          >
          {% if page.url contains '/blog/' and page.url != '/blog/' %}
            <button class="nav-search" type="button" data-search-open aria-label="Search the blog">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" />
              </svg>
              <span>Search</span>
              <kbd class="search-shortcut">⌘K</kbd>
            </button>
          {% endif %}
        </nav>
      </header>
      {{ content }}
      <footer class="contact">
        <div><span>GitHub</span><a href="https://github.com/lamng3">@lamng3</a></div>
        <div><span>Scholar</span><a href="https://scholar.google.com/citations?user=ws80Q0IAAAAJ">Lam Nguyen</a></div>
        <div><span>LeetCode</span><a href="https://leetcode.com/u/lamng3/">@lamng3</a></div>
        <div><span>Email</span><a href="mailto:lamng3.work@gmail.com">lamng3.work@gmail.com</a></div>
      </footer>
    </main>
    {% if page.url contains '/blog/' %}
      {% include search.liquid %}
    {% endif %}
    {% if page.layout == 'template' or page.url == '/library/' or page.url == '/projects/' %}
      <script defer src="{{ '/assets/js/pages.js' | relative_url }}"></script>
    {% endif %}
    {% if page.toc %}
      <script defer src="{{ '/assets/js/toc.js' | relative_url }}"></script>
    {% endif %}
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/contrib/auto-render.min.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        if (!window.renderMathInElement) return;
        renderMathInElement(document.body, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '\\[', right: '\\]', display: true },
            { left: '\\(', right: '\\)', display: false },
            { left: '$', right: '$', display: false },
          ],
          throwOnError: false,
          ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
          ignoredClasses: ['no-math'],
        });
      });
    </script>
  </body>
</html>
