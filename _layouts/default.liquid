<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {%- if page.url == '/' -%}
        {{ site.title }}
      {%- else -%}
        {{ page.title }} · {{ site.title }}
      {%- endif -%}
    </title>
    <meta name="description" content="{{ page.description | default: site.description | strip }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/site.css' | relative_url }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css">
  </head>
  <body>
    <main>
      <nav class="sitenav" aria-label="Site">
        <a
          href="{{ '/' | relative_url }}"
          {% if page.url == '/' %}
            aria-current="page"
          {% endif %}
          >Home</a
        >
        <a
          href="{{ '/blog/' | relative_url }}"
          {% if page.url contains '/blog/' %}
            aria-current="page"
          {% endif %}
          >Blog</a
        >
        <a
          href="{{ '/publications/' | relative_url }}"
          {% if page.url contains '/publications/' %}
            aria-current="page"
          {% endif %}
          >Publications</a
        >
        {% if page.url contains '/blog/' and page.url != '/blog/' %}
          <button class="nav-search" type="button" data-search-open aria-label="Search the blog">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" />
            </svg>
            <span>Search</span>
            <kbd class="search-shortcut">⌘K</kbd>
          </button>
        {% endif %}
      </nav>
      {{ content }}
      <footer>
        <p>© {{ site.time | date: '%Y' }} Lam Nguyen</p>
      </footer>
    </main>
    {% if page.url contains '/blog/' %}
      {% include search.liquid %}
    {% endif %}
    {% if page.toc %}
      <script defer src="{{ '/assets/js/toc.js' | relative_url }}"></script>
    {% endif %}
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/contrib/auto-render.min.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        if (!window.renderMathInElement) return;
        renderMathInElement(document.body, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '\\[', right: '\\]', display: true },
            { left: '\\(', right: '\\)', display: false },
            { left: '$', right: '$', display: false },
          ],
          throwOnError: false,
          ignoredTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
          ignoredClasses: ['no-math'],
        });
      });
    </script>
  </body>
</html>
